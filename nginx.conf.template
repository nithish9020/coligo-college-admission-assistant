events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 25M;

    upstream backend_api {
        server 127.0.0.1:8001;
    }

    upstream frontend_portal {
        server 127.0.0.1:8501;
    }

    server {
        listen ${PORT};
        server_name _;

        # FastAPI Backend endpoints
        location ~ ^/(api|webhook|chat|cutoffs|colleges|brochures|courses|facilities|escalations|analytics|auth|documents|health|docs|redoc|openapi.json) {
            proxy_pass http://backend_api;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # Streamlit Admin Portal (Root, static, and real-time websockets)
        location / {
            proxy_pass http://frontend_portal;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400s;
        }
    }
}
