FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY administration_portal/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -e .

COPY api ./api
COPY data ./data
COPY app ./app
COPY administration_portal ./administration_portal

EXPOSE 8501

CMD ["streamlit", "run", "administration_portal/portal.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]
