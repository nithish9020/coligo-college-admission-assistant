FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY administration_portal/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY administration_portal ./administration_portal

EXPOSE 8501

CMD ["streamlit", "run", "administration_portal/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]
