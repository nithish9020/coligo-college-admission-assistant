# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored — never commit real secrets.
# These map 1:1 to api/core/config.py::Settings

PROJECT_NAME="Coligo College Admission Assistant API"
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# Docs / Swagger settings — set to empty string to disable a page in production
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Database Settings
DATABASE_URL=postgresql+asyncpg://dte:dte_secret@localhost:5432/dte_chatbot

# Gemini API Settings
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.5-flash

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RAG_TOP_K=5

# Conversation memory. TTL matches WhatsApp's 24h service-conversation window.
# MAX_TURNS caps history sent to the model (6 = ~3 exchanges).
CONVERSATION_TTL_HOURS=24
CONVERSATION_MAX_TURNS=6
# Rewrite follow-ups ("what about ECE?") into standalone questions before
# embedding, so retrieval finds the right chunks. Costs one extra LLM call per
# message that has history; set false to save Gemini quota.
ENABLE_QUERY_REWRITING=true

# WhatsApp Cloud API (Meta) — see README "WhatsApp Integration"
# Phone Number ID + Access Token: Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret: Meta App Dashboard > Settings > Basic (used to verify
# X-Hub-Signature-256 on incoming webhook calls)
WHATSAPP_APP_SECRET=
# Verify Token: any string you invent — register the same value in
# Meta App Dashboard > WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=
# Graph API version used for outbound sends
WHATSAPP_API_VERSION=v21.0
# Comma-separated phone numbers (with country code) treated as admins
ADMIN_NUMBERS=

# Administration Portal — Auth Settings
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Administration Portal — Fixed Platform Admin Login
ADMIN_EMAIL=admin@coligo.com
ADMIN_PASSWORD=coligo@123

# Administration Portal — File Uploads
UPLOAD_DIR=uploads
MAX_LOGO_SIZE_MB=2
MAX_BROCHURE_SIZE_MB=10
