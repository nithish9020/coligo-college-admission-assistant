# Copy this file to `.env` and adjust values for your local environment.
# `.env` is git-ignored — never commit real secrets.
# These map 1:1 to api/core/config.py::Settings

PROJECT_NAME="Coligo College Admission Assistant API"
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# Docs / Swagger settings — set to empty string to disable a page in production
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
