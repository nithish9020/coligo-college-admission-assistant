# ==============================================================================
# COLIGO APPLICATION ENVIRONMENT CONFIGURATION
# Copy this file to `.env` for local development. Never commit `.env` with real secrets.
# ==============================================================================

# General Application Settings
PROJECT_NAME="Coligo College Admission Assistant API"
VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

# Docs / Swagger Settings (set to empty string to disable in production)
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dte:dte_secret@localhost:5432/dte_chatbot

# ------------------------------------------------------------------------------
# 2. LLM PROVIDER & MODEL SELECTION
# Supported: "groq" | "gemini" | "openai" | "deepseek" | "ollama"
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Groq (Get free API key at https://console.groq.com):
GROQ_API_KEY=gsk_your_groq_api_key_here

# DeepSeek (https://platform.deepseek.com):
# DEEPSEEK_API_KEY=sk_your_deepseek_key_here

# OpenAI:
# OPENAI_API_KEY=sk_your_openai_key_here

# Self-Hosted Ollama on Azure VM / local:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. GEMINI AI & RAG EMBEDDINGS (https://aistudio.google.com)
# ------------------------------------------------------------------------------
# Used for pgvector document embeddings (768-dim) and default fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768

# RAG Chunking Parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RAG_TOP_K=5

# Conversation Memory (TTL=24h matches WhatsApp session window; MAX_TURNS=6)
CONVERSATION_TTL_HOURS=24
CONVERSATION_MAX_TURNS=6
ENABLE_QUERY_REWRITING=true

# ------------------------------------------------------------------------------
# 3. WHATSAPP CLOUD API (META)
# ------------------------------------------------------------------------------
# Phone Number ID & Permanent Access Token from Meta Developer Dashboard
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Verification token for Meta webhook handshake (set same value in Meta Dashboard)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Optional: Meta App Secret for HMAC SHA-256 signature verification
WHATSAPP_APP_SECRET=

# Graph API Version
WHATSAPP_API_VERSION=v21.0

# Optional: Comma-separated admin phone numbers (with country code, e.g., 919876543210)
ADMIN_NUMBERS=
